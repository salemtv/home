{
    "name": "Salem TV",
    "short_name": "STV",
    "description": "Online",
    "start_url": "/index.html",
    "display": "standalone",
    "background_color": "#0a0a0a",
    "theme_color": "#0a0a0a",
    "orientation": "portrait-primary",
    /* ============================================ */
    /* [NUEVO] ICONOS PNG - Reemplazados los SVG inline por PNG reales */
    /* icon-192x192.png y icon-512x512.png para PWA estándar */
    /* maskable-icon-* para Android adaptive icons */
    /* ============================================ */
    "icons": [
        {
            "src": "icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "maskable-icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "maskable-icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
